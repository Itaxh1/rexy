{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rexy",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "rexy.baememory.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
